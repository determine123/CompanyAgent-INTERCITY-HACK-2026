# Example only, not valid credentials. Copy to deploy/public-demo/.env ON YOUR VPS.
# Keep the actual .env UNTRACKED. DO NOT paste passwords into chat or Issues.
PUBLIC_DEMO_DOMAIN=demo.example.com
PUBLIC_DEMO_USER=reviewer
# Generate interactively: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Wrap in single quotes so Docker Compose will NOT interpolate bcrypt's $ characters.
PUBLIC_DEMO_BCRYPT_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
# Must be a different strong password from Basic Auth; the application has a second login.
PUBLIC_DEMO_APP_PASSWORD='REPLACE_WITH_DISTINCT_20_PLUS_CHARACTER_PASSWORD'
