# Optional: only set if you want AI strategy text via competition model.
# Do not put the key into frontend code or Git.
B1X_API_KEY=
HOST=127.0.0.1
PORT=8765

# CompanyAgent v0.9 Problem-driven Agent Hub (single-organization local prototype)
# First launch generates a random admin password at runtime/FIRST_LOGIN.txt
# Optional override: provide a DIFFERENT secret with at least 12 characters before first launch.
COMPANYAGENT_ADMIN_PASSWORD=
# Disabled by default. When enabled, polls runtime/imports every 60 s and approved HTTPS sources at configured intervals.
COMPANYAGENT_AUTO_SYNC=false
# Comma-separated permitted DNS hosts, exact HTTPS 443 only. Example: data.company.example
COMPANYAGENT_ALLOWED_DATA_HOSTS=
# Store remote connector credentials server-side only.
# COMPANYAGENT_SOURCE_A_TOKEN=
COMPANYAGENT_COOKIE_SECURE=false

# v1.2 B1X true Chat Completions tool loop (optional, NEVER commit the value)
# B1X_API_KEY=SET_ONLY_IN_YOUR_SERVER_ENVIRONMENT

# v1.4 optional provider selection for bounded /enterprise/api/runs/{id}/model-tools.
# Only "b1x" (default) and "tokendance" are allowed. Never set a custom URL.
COMPANYAGENT_MODEL_PROVIDER=b1x
# For TokenDance ONLY, change provider to tokendance and set these locally.
# Redeem your credit voucher in your own account first; the voucher itself is NOT an API key.
TOKENDANCE_API_KEY=
# Copy a currently supported OpenAI Chat Completions model ID from your TokenDance console.
# Confirm that this specific model supports function/tool calling before live acceptance.
TOKENDANCE_MODEL=
